WEATHER_DEVICE_TOKEN=REPLACE_WITH_A_PRIVATE_DEVICE_TOKEN
# Disabled by default. Keep disabled until the dashboard push setup is complete.
WEATHER_PUSH_ENABLED=false
DASHBOARD_ORIGIN=https://YOUR_DASHBOARD_DOMAIN
PUSH_SEND_SECRET=
# Existing writable directory on a persistent disk, used by one uvicorn worker.
WEATHER_ALERT_DB_PATH=/data/weather-alerts.sqlite3
# Set your chosen thresholds and hysteresis. Blank means disabled for that metric.
WEATHER_ALERT_CO2_HIGH=
WEATHER_ALERT_CO2_HYSTERESIS=
WEATHER_ALERT_PM25_HIGH=
WEATHER_ALERT_PM25_HYSTERESIS=
